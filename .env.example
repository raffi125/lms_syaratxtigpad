# ==============================================================================
# SUPABASE CONFIGURATION TEMPLATE
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Kunci service role (hanya di server, JANGAN di-expose ke browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# SESSION SECURITY (WAJIB)
# ==============================================================================
# Secret untuk menandatangani sesi login server (HttpOnly cookie).
# Wajib minimal 32 karakter. GENERATE: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
# Set nilai yang SAMA di semua environment (lokal, Vercel, dll) agar sesi konsisten.
KOLAB_SESSION_SECRET=generate-a-long-random-hex-secret-at-least-32-chars
